<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.marabou-tunnel</string>

  <!-- Forwards 127.0.0.1:9999 on this Mac to the vLLM server on marabou.
       Chrome cannot reach the local network on this Mac, but loopback is always allowed. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/ssh</string>
    <string>-N</string>
    <string>-o</string><string>BatchMode=yes</string>
    <string>-o</string><string>ExitOnForwardFailure=yes</string>
    <string>-o</string><string>ServerAliveInterval=30</string>
    <string>-o</string><string>ServerAliveCountMax=3</string>
    <string>-L</string><string>127.0.0.1:9999:127.0.0.1:9999</string>
    <string>YOUR-SSH-HOST</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Away from the home network ssh fails at once; wait a minute before each retry. -->
  <key>ThrottleInterval</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>$HOME/Library/Logs/marabou-tunnel.log</string>
  <key>StandardErrorPath</key>
  <string>$HOME/Library/Logs/marabou-tunnel.log</string>
</dict>
</plist>

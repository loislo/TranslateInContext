{
  "manifest_version": 3,
  "name": "Translate in Context",
  "version": "1.0.0",
  "description": "Double-click a word to translate it in the context of its sentence using an LLM.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://family/*"
  ],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Translate in Context settings"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
